# ============================================================
# AI Junkie Updates — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the required values.
# All variables are prefixed with AIJU_ for namespace isolation.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — the system will not start without these
# ----------------------------------------------------------

# Anthropic API key (https://console.anthropic.com/)
AIJU_ANTHROPIC_API_KEY=

# Telegram Bot token (from @BotFather)
AIJU_TELEGRAM_BOT_TOKEN=

# Telegram channel IDs for each alert tier
# Use the numeric channel ID (e.g. -1001234567890)
AIJU_TELEGRAM_CHANNEL_CRITICAL=
AIJU_TELEGRAM_CHANNEL_HIGH=
AIJU_TELEGRAM_CHANNEL_GENERAL=
AIJU_TELEGRAM_CHANNEL_WATCHLIST=

# Your personal chat ID — restricts interactive bot commands to you (Phase 2)
AIJU_TELEGRAM_ADMIN_CHAT_ID=

# ----------------------------------------------------------
# OPTIONAL — defaults shown
# ----------------------------------------------------------

# SQLite database URL (async)
AIJU_DATABASE_URL=sqlite+aiosqlite:///storage/aiju.db

# In-memory cache TTL in seconds (default: 24 hours)
AIJU_CACHE_TTL_SECONDS=86400

# Minimum score to deliver an update (0–100)
AIJU_SCORE_THRESHOLD_DELIVER=50

# Minimum score for watchlist-only delivery
AIJU_SCORE_THRESHOLD_WATCHLIST=40

# How often agents poll their sources (seconds)
AIJU_POLL_INTERVAL_SECONDS=300

# Maximum number of agents polling concurrently
AIJU_MAX_CONCURRENT_AGENTS=5

# Claude models: a cheap model for per-item triage (most calls), and a stronger
# model reserved for periodic synthesis / digests (Phase 1).
AIJU_CLAUDE_TRIAGE_MODEL=claude-haiku-4-5-20251001
AIJU_CLAUDE_SYNTHESIS_MODEL=claude-sonnet-4-6

# Logging level (DEBUG, INFO, WARNING, ERROR)
AIJU_LOG_LEVEL=INFO

# --- Intelligence layer ---
# Set false to run collection-only (no LLM synthesis) for cost control.
AIJU_ENABLE_SYNTHESIS=true
# Calendar-aligned digests: daily at this UTC hour, weekly on this weekday (0=Mon).
AIJU_DIGEST_USE_CLOCK=true
AIJU_DIGEST_HOUR=8
AIJU_WEEKLY_DIGEST_DOW=0
# Only events at/above this significance trigger an advisor brief.
AIJU_BRIEF_MIN_SIGNIFICANCE=70

# --- Data retention ---
# Prune event-linked raw items older than N days (0 disables). Keeps SQLite small.
AIJU_RETENTION_DAYS=60

# --- Health check server ---
AIJU_HEALTH_CHECK_ENABLED=true
AIJU_HEALTH_CHECK_PORT=8585

# --- Optional: source API keys (sources without keys are skipped gracefully) ---
# X/Twitter API (the X RSS-bridge path needs no key; this is for the API agent)
# TWITTER_BEARER_TOKEN=
# GITHUB_TOKEN=
# CRUNCHBASE_API_KEY=
# PITCHBOOK_API_KEY=
# NEWSAPI_API_KEY=
